{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PMBOT_LLM_ANALYSIS_PACKET.v1",
  "schema_version": "llm_analysis_packet_schema.v1",
  "title": "PMBOT LLM Analysis Packet v1",
  "description": "Offline-only local contract for sanitized PMBOT artifacts prepared for manual LLM review. This schema defines data shape only and does not define any runtime, API, prompt automation, strategy, probability estimate, scoring, side recommendation, or trading behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "packet_id",
    "generated_at",
    "source_artifacts",
    "market_context",
    "normalized_market_summary",
    "research_summary",
    "evidence_summary",
    "operator_questions",
    "known_limitations",
    "forbidden_outputs",
    "required_response_sections",
    "safety_constraints"
  ],
  "properties": {
    "contract_version": {
      "const": "llm_analysis_packet.v1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "llm-analysis-packet-[a-z0-9-]+"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_type",
          "path",
          "description",
          "sanitization_status"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sanitization_status": {
            "enum": [
              "safe_public_or_local_artifact_reference_only",
              "fixture_only"
            ]
          }
        }
      }
    },
    "market_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_id",
        "market_title",
        "market_status",
        "public_resolution_context",
        "outcome_labels"
      ],
      "properties": {
        "market_id": {
          "type": "string",
          "minLength": 1
        },
        "market_title": {
          "type": "string",
          "minLength": 1
        },
        "market_status": {
          "enum": [
            "open",
            "closed",
            "resolved",
            "suspended",
            "unknown"
          ]
        },
        "public_resolution_context": {
          "type": "string",
          "minLength": 1
        },
        "outcome_labels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "normalized_market_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_text",
        "status",
        "outcome_labels",
        "resolution_rules_summary",
        "data_freshness_note",
        "excluded_fields_note"
      ],
      "properties": {
        "question_text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "resolved",
            "suspended",
            "unknown"
          ]
        },
        "outcome_labels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resolution_rules_summary": {
          "type": "string",
          "minLength": 1
        },
        "data_freshness_note": {
          "type": "string",
          "minLength": 1
        },
        "excluded_fields_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "research_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_status",
        "summary",
        "completed_sections",
        "open_questions"
      ],
      "properties": {
        "research_status": {
          "enum": [
            "stub_only",
            "partial_manual_review",
            "manual_review_ready",
            "needs_more_information"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "completed_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim_summary",
          "source_reference",
          "source_type",
          "relevance_note",
          "limitation_note"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_summary": {
            "type": "string",
            "minLength": 1
          },
          "source_reference": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "operator_artifact",
              "manual_note",
              "official_source_reference",
              "news_source_reference",
              "fixture"
            ]
          },
          "relevance_note": {
            "type": "string",
            "minLength": 1
          },
          "limitation_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operator_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_outputs": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_response_sections": {
      "type": "array",
      "minItems": 9,
      "items": {
        "enum": [
          "concise_market_summary",
          "key_uncertainties",
          "missing_evidence",
          "contradiction_checks",
          "risk_notes",
          "operator_review_checklist",
          "suggested_research_questions",
          "citation_or_source_gap_notes",
          "safety_acknowledgement"
        ]
      }
    },
    "safety_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_only",
        "local_files_only",
        "manual_review_only",
        "no_network_calls",
        "no_llm_api_calls",
        "no_credentials",
        "no_wallet_or_key_material",
        "no_trading_endpoints",
        "no_real_orders",
        "no_live_trading",
        "no_autonomous_paper_orders",
        "no_outcome_estimates",
        "no_value_or_advantage_scoring",
        "no_side_selection",
        "no_market_decisions",
        "no_runtime_wiring",
        "no_dispatcher_changes",
        "no_prompt_automation"
      ],
      "properties": {
        "offline_only": {
          "const": true
        },
        "local_files_only": {
          "const": true
        },
        "manual_review_only": {
          "const": true
        },
        "no_network_calls": {
          "const": true
        },
        "no_llm_api_calls": {
          "const": true
        },
        "no_credentials": {
          "const": true
        },
        "no_wallet_or_key_material": {
          "const": true
        },
        "no_trading_endpoints": {
          "const": true
        },
        "no_real_orders": {
          "const": true
        },
        "no_live_trading": {
          "const": true
        },
        "no_autonomous_paper_orders": {
          "const": true
        },
        "no_outcome_estimates": {
          "const": true
        },
        "no_value_or_advantage_scoring": {
          "const": true
        },
        "no_side_selection": {
          "const": true
        },
        "no_market_decisions": {
          "const": true
        },
        "no_runtime_wiring": {
          "const": true
        },
        "no_dispatcher_changes": {
          "const": true
        },
        "no_prompt_automation": {
          "const": true
        }
      }
    }
  },
  "contract_boundary": {
    "local_only": true,
    "deterministic": true,
    "fixture_safe": true,
    "llm_api_defined": false,
    "runtime_integration_defined": false,
    "trading_or_ordering_defined": false,
    "strategy_defined": false,
    "side_selection_defined": false,
    "outcome_estimation_defined": false,
    "value_scoring_defined": false
  }
}
