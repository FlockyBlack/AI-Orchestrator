{
  "additional_fields_allowed": false,
  "contract_version": "pmbot_simulated_decision_packet.v1",
  "description": "Local static schema for descriptive PMBOT simulation records that require human review before any downstream use.",
  "local_only": true,
  "operator_review_required": true,
  "properties": {
    "contract_version": {
      "constant": "pmbot_simulated_decision_packet.v1",
      "type": "string"
    },
    "created_at": {
      "format": "utc_timestamp",
      "type": "string"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "input_artifacts": {
      "items": {
        "additional_fields_allowed": false,
        "required_fields": [
          "artifact_id",
          "artifact_type",
          "local_reference",
          "description",
          "operator_review_status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "local_only": {
      "constant": true,
      "type": "boolean"
    },
    "market_snapshot": {
      "additional_fields_allowed": false,
      "required_fields": [
        "market_id",
        "market_title",
        "question_text",
        "status",
        "local_reference"
      ],
      "type": "object"
    },
    "operator_notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "operator_review": {
      "additional_fields_allowed": false,
      "required_fields": [
        "status",
        "reviewed_by",
        "reviewed_at",
        "notes"
      ],
      "type": "object"
    },
    "operator_review_required": {
      "constant": true,
      "type": "boolean"
    },
    "packet_id": {
      "pattern": "^[a-z0-9_.-]+$",
      "type": "string"
    },
    "packet_state": {
      "constant": "recorded_for_operator_review",
      "type": "string"
    },
    "record_sections": {
      "items": {
        "additional_fields_allowed": false,
        "required_fields": [
          "section_id",
          "section_label",
          "observations",
          "operator_review_status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run_mode": {
      "constant": "offline_recordkeeping",
      "type": "string"
    },
    "safety_boundaries": {
      "additional_fields_allowed": false,
      "required_fields": [
        "authenticated_service_allowed",
        "external_market_api_allowed",
        "llm_calls_allowed",
        "network_calls_allowed",
        "offline_inputs_only",
        "operator_review_gate_required",
        "paper_record_only",
        "runtime_wiring_allowed",
        "scheduler_or_worker_allowed",
        "market_instruction_allowed",
        "numeric_estimate_allowed",
        "ranked_candidate_allowed",
        "transaction_signing_allowed",
        "wallet_access_allowed"
      ],
      "type": "object"
    },
    "schema_reference": {
      "type": "string"
    },
    "summary_counts": {
      "additional_fields_allowed": false,
      "required_fields": [
        "input_artifacts",
        "record_sections",
        "observations",
        "warnings"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "recordkeeping_mode": "offline_recordkeeping",
  "required_fields": [
    "contract_version",
    "packet_id",
    "run_mode",
    "local_only",
    "operator_review_required",
    "packet_state",
    "schema_reference",
    "created_at",
    "market_snapshot",
    "input_artifacts",
    "record_sections",
    "operator_notes",
    "operator_review",
    "summary_counts",
    "safety_boundaries",
    "warnings",
    "errors"
  ],
  "safety_boundaries": {
    "authenticated_service_allowed": false,
    "external_market_api_allowed": false,
    "llm_calls_allowed": false,
    "market_instruction_allowed": false,
    "network_calls_allowed": false,
    "numeric_estimate_allowed": false,
    "offline_inputs_only": true,
    "operator_review_gate_required": true,
    "paper_record_only": true,
    "ranked_candidate_allowed": false,
    "runtime_wiring_allowed": false,
    "scheduler_or_worker_allowed": false,
    "transaction_signing_allowed": false,
    "wallet_access_allowed": false
  },
  "schema_id": "pmbot_simulated_decision_packet_schema.v1",
  "schema_kind": "local_static_record_schema",
  "title": "PMBOT simulated decision packet schema"
}
