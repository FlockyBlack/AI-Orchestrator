{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_rules_normalized_candidate.schema.v1",
  "title": "PMBOT Market Rules Normalized Candidate Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "market_id",
    "normalized_question",
    "normalized_resolution_criteria_text",
    "normalized_resolution_rules",
    "official_source_references",
    "official_source_urls_or_rule_references",
    "source_timestamps",
    "source_reliability_review",
    "unresolved_source_questions",
    "operator_review_completeness_band",
    "operator_review_required",
    "no_market_action_guidance",
    "safety_summary"
  ],
  "properties": {
    "contract_version": {
      "const": "market_rules_normalized_candidate.v1"
    },
    "market_id": {
      "type": "string"
    },
    "normalized_question": {
      "type": "string"
    },
    "normalized_resolution_criteria_text": {
      "type": "string"
    },
    "normalized_resolution_rules": {
      "type": "string"
    },
    "official_source_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "official_source_urls_or_rule_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_timestamps": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "source_reliability_review": {
      "type": "string"
    },
    "unresolved_source_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "operator_review_completeness_band": {
      "enum": [
        "empty",
        "partial",
        "rules_text_present",
        "rules_and_sources_present"
      ]
    },
    "source_capture_completeness_band": {
      "enum": [
        "empty",
        "partial",
        "rules_text_present",
        "rules_and_sources_present"
      ]
    },
    "operator_review_required": {
      "const": true
    },
    "no_market_action_guidance": {
      "const": true
    },
    "safety_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_review_only",
        "analysis_only",
        "probability_ev_edge_confidence_generated",
        "side_selection_generated",
        "market_action_guidance_generated",
        "canonical_packets_mutated"
      ],
      "properties": {
        "operator_review_only": {
          "const": true
        },
        "analysis_only": {
          "const": true
        },
        "probability_ev_edge_confidence_generated": {
          "const": false
        },
        "side_selection_generated": {
          "const": false
        },
        "market_action_guidance_generated": {
          "const": false
        },
        "canonical_packets_mutated": {
          "const": false
        }
      }
    }
  }
}
