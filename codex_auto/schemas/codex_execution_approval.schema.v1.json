{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexExecutionApprovalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "task_id",
    "approved_for_execution",
    "approved_by",
    "approved_at",
    "approval_reason",
    "allowed_paths",
    "forbidden_paths",
    "max_files_changed",
    "expected_tests",
    "rollback_plan",
    "validation_required_after_execution",
    "execution_scope",
    "expires_at",
    "safety_flags_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "codex_execution_approval.v1"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "approved_for_execution": {
      "type": "boolean",
      "const": true
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "approval_reason": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_files_changed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "expected_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback_plan": {
      "type": "string",
      "minLength": 1
    },
    "validation_required_after_execution": {
      "type": "boolean",
      "const": true
    },
    "execution_scope": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    },
    "safety_flags_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "runtime_changed",
          "dispatcher_touched",
          "run_codex_touched",
          "active_task_files_touched",
          "freeze_record_modified",
          "result_records_modified",
          "checkpoint_records_modified",
          "network_used",
          "api_used",
          "wallet_used",
          "private_key_used",
          "trading_used",
          "single_runtime_source_rule_preserved"
        ]
      }
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "allowed_paths": {
            "contains": {
              "type": "string",
              "pattern": "(?i)(scripts/dispatcher\\.py|scripts/run_codex\\.py|tasks/|state/|runtime|loop|results?|checkpoints?|freeze)"
            }
          }
        },
        "required": [
          "allowed_paths"
        ]
      }
    },
    {
      "properties": {
        "forbidden_paths": {
          "allOf": [
            {
              "contains": {
                "const": "scripts/dispatcher.py"
              }
            },
            {
              "contains": {
                "const": "scripts/run_codex.py"
              }
            },
            {
              "contains": {
                "const": "tasks/"
              }
            },
            {
              "contains": {
                "const": "state/"
              }
            }
          ]
        }
      }
    },
    {
      "not": {
        "properties": {
          "execution_scope": {
            "pattern": "(?i)(runtime wiring|dispatcher|run_codex|active task|network|api|wallet|private key|trading|real orders?|live polymarket|source of truth)"
          }
        },
        "required": [
          "execution_scope"
        ]
      }
    }
  ],
  "description": "Offline approval guardrail for future controlled Codex execution. Allowed paths must remain sandboxed, forbidden paths must protect dispatcher, run_codex, active tasks, runtime loop, and state or result or freeze or checkpoint records, validation after execution is mandatory, and execution scope must exclude runtime wiring, network, API, wallet, private key, trading, real orders, live Polymarket API, and second runtime source of truth."
}
