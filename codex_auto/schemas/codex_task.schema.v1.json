{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexTaskV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "created_at",
    "mode",
    "executor",
    "project_path",
    "prompt",
    "allowed_paths",
    "forbidden_paths",
    "forbidden_behaviors",
    "requires_human_approval",
    "approved_for_execution",
    "dry_run_default",
    "expected_result_shape",
    "safety_flags_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "codex_task.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "CODEX_SAFE_IMPLEMENTATION",
        "FIXTURE_ONLY",
        "PAPER_ONLY",
        "DESIGN_ONLY",
        "READ_ONLY_VALIDATION",
        "DRY_RUN_ONLY"
      ]
    },
    "executor": {
      "type": "string",
      "const": "codex"
    },
    "project_path": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_human_approval": {
      "type": "boolean",
      "const": true,
      "description": "Must remain true for every task."
    },
    "approved_for_execution": {
      "type": "boolean",
      "const": false,
      "description": "Safe default must be false until a later controlled approval stage."
    },
    "dry_run_default": {
      "type": "boolean",
      "const": true,
      "description": "Tasks default to dry-run only."
    },
    "expected_result_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "execution_mode",
        "safety_check"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "execution_mode": {
          "type": "string"
        },
        "safety_check": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "safety_flags_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "runtime_changed",
          "dispatcher_touched",
          "run_codex_touched",
          "active_task_files_touched",
          "freeze_record_modified",
          "result_records_modified",
          "checkpoint_records_modified",
          "network_used",
          "api_used",
          "wallet_used",
          "private_key_used",
          "trading_used",
          "single_runtime_source_rule_preserved"
        ]
      }
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "prompt": {
            "pattern": "(?i)(runtime wiring|dispatcher|run_codex|active task|task ledger|checkpoint|freeze record|network|api|wallet|private key|trading|real order|live polymarket|source of truth|rewrite accepted warning)"
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    {
      "not": {
        "properties": {
          "allowed_paths": {
            "contains": {
              "type": "string",
              "pattern": "(?i)(scripts/dispatcher\\.py|scripts/run_codex\\.py|tasks/|state/|runtime|loop|results?|checkpoints?)"
            }
          }
        },
        "required": [
          "allowed_paths"
        ]
      }
    },
    {
      "not": {
        "properties": {
          "forbidden_behaviors": {
            "contains": {
              "type": "string",
              "pattern": "(?i)(allow network|allow api|allow wallet|allow trading|allow runtime wiring)"
            }
          }
        },
        "required": [
          "forbidden_behaviors"
        ]
      }
    }
  ],
  "description": "Safe local Codex task envelope. Rejects or describes rejection for runtime wiring, dispatcher or run_codex modification, active task mutation, network or API usage, wallet or private key usage, trading or real order execution, live Polymarket API access, hidden warning rewrites, and second runtime source of truth attempts."
}
