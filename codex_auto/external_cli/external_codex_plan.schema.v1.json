{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Codex Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "created_at",
    "prompt_pack_ref",
    "prompt_manifest_ref",
    "candidate_task_refs",
    "command_preview",
    "execution_allowed_now",
    "external_codex_cli_allowed_now",
    "requires_human_approval_before_execution",
    "requires_flocky_review_before_execution",
    "expected_result_path",
    "expected_validation_after_execution",
    "allowed_paths",
    "forbidden_paths",
    "safety_check"
  ],
  "properties": {
    "schema_version": {
      "const": "external_codex_plan.v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "prompt_pack_ref": {
      "type": "string",
      "pattern": "^codex_auto/prompts/[^\\n]+\\.codex_prompt\\.txt$"
    },
    "prompt_manifest_ref": {
      "type": "string",
      "pattern": "^codex_auto/prompts/[^\\n]+\\.prompt_manifest\\.json$"
    },
    "candidate_task_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^codex_auto/tasks/candidates/[^\\n]+\\.task\\.json$"
      }
    },
    "command_preview": {
      "type": "string",
      "minLength": 1
    },
    "execution_allowed_now": {
      "const": false
    },
    "external_codex_cli_allowed_now": {
      "const": false
    },
    "requires_human_approval_before_execution": {
      "const": true
    },
    "requires_flocky_review_before_execution": {
      "const": true
    },
    "expected_result_path": {
      "type": "string",
      "minLength": 1
    },
    "expected_validation_after_execution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "safety_check": {
      "type": "object"
    }
  }
}
