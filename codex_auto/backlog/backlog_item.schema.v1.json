{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexAutoBacklogItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "mode",
    "executor",
    "summary",
    "allowed_scope",
    "forbidden_scope",
    "done_criteria"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "mode": {
      "type": "string",
      "enum": [
        "DESIGN_ONLY",
        "FIXTURE_ONLY",
        "PAPER_ONLY",
        "READ_ONLY_VALIDATION",
        "DRY_RUN_ONLY"
      ]
    },
    "executor": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "allowed_scope": {
      "type": "array",
      "items": {"type": "string"}
    },
    "forbidden_scope": {
      "type": "array",
      "items": {"type": "string"}
    },
    "done_criteria": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "description": "Safe codex_auto backlog input. Live trading, wallet, private key, real order execution, runtime wiring, and network/API execution modes are forbidden."
}
