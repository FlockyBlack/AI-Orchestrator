{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexAutoQueueTaskRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_task_id",
    "codex_task_id",
    "source_task_path",
    "queue_state",
    "created_at",
    "allowed_next_states",
    "approval_required",
    "flocky_validation_required",
    "runtime_wiring_allowed",
    "task_payload_ref",
    "safety_flags"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "queue_task_record.v1"
    },
    "queue_task_id": {
      "type": "string",
      "minLength": 1
    },
    "codex_task_id": {
      "type": "string",
      "minLength": 1
    },
    "source_task_path": {
      "type": "string",
      "minLength": 1
    },
    "queue_state": {
      "type": "string",
      "enum": [
        "ready",
        "running",
        "done",
        "failed",
        "needs_flocky_review",
        "quarantine"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "allowed_next_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "flocky_validation_required": {
      "type": "boolean",
      "const": true
    },
    "runtime_wiring_allowed": {
      "type": "boolean",
      "const": false
    },
    "task_payload_ref": {
      "type": "string",
      "minLength": 1
    },
    "safety_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "description": "Codex-auto queue bookkeeping only. This record is not AI-Orchestrator runtime truth and must not skip required Flocky validation before done."
}
