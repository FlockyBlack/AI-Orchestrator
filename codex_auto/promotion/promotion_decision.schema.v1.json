{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Promotion Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_decision_id",
    "promotion_request_id",
    "decided_at",
    "decided_by",
    "decision",
    "candidate_task_refs",
    "prompt_pack_ref",
    "validation_findings",
    "approved_for_ready_promotion",
    "approved_for_execution",
    "runtime_wiring_allowed",
    "external_codex_cli_allowed_now",
    "human_approval_required_before_execution",
    "notes",
    "recommended_next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "promotion_decision.v1"
    },
    "promotion_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "promotion_request_id": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "minLength": 1
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approve_for_ready_promotion",
        "hold_for_review",
        "reject"
      ]
    },
    "candidate_task_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^codex_auto/tasks/candidates/[^\\n]+\\.task\\.json$"
      }
    },
    "prompt_pack_ref": {
      "type": "string",
      "pattern": "^codex_auto/prompts/[^\\n]+\\.codex_prompt\\.txt$"
    },
    "validation_findings": {
      "type": "object"
    },
    "approved_for_ready_promotion": {
      "type": "boolean"
    },
    "approved_for_execution": {
      "const": false
    },
    "runtime_wiring_allowed": {
      "const": false
    },
    "external_codex_cli_allowed_now": {
      "const": false
    },
    "human_approval_required_before_execution": {
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "approve_for_ready_promotion"
          }
        }
      },
      "then": {
        "properties": {
          "approved_for_ready_promotion": {
            "const": true
          }
        }
      }
    }
  ]
}
