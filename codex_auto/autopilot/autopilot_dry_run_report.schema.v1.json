{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autopilot_dry_run_report.schema.v1.json",
  "title": "Autopilot V1 Dry Run Flow Report",
  "type": "object",
  "required": [
    "schema_version",
    "dry_run_only",
    "runtime_authority",
    "final_acceptance_authority",
    "source_task_id",
    "authoritative_task_path",
    "authoritative_run_path_or_ref",
    "preview_handoff_ref_or_inline",
    "preview_validation_report",
    "flow_steps",
    "allowed_paths",
    "forbidden_paths",
    "stop_conditions",
    "approval_required_before_execution",
    "flocky_validation_required",
    "execution_allowed_now",
    "runtime_wiring_allowed",
    "queue_mutation_allowed",
    "final_acceptance_claimed",
    "single_runtime_source_rule_preserved",
    "status_ownership",
    "next_action_recommendation",
    "warnings",
    "errors",
    "generated_by",
    "deterministic_dry_run"
  ],
  "properties": {
    "schema_version": { "const": "autopilot_dry_run_report.v1" },
    "dry_run_only": { "const": true },
    "runtime_authority": { "const": false },
    "final_acceptance_authority": { "const": false },
    "source_task_id": { "type": "string", "minLength": 1 },
    "authoritative_task_path": { "type": "string", "minLength": 1 },
    "authoritative_run_path_or_ref": { "type": "string", "minLength": 1 },
    "preview_handoff_ref_or_inline": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object" }
      ]
    },
    "preview_validation_report": { "type": "object" },
    "flow_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 14,
      "items": { "type": "string", "minLength": 1 }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "approval_required_before_execution": { "const": true },
    "flocky_validation_required": { "const": true },
    "execution_allowed_now": { "const": false },
    "runtime_wiring_allowed": { "const": false },
    "queue_mutation_allowed": { "const": false },
    "final_acceptance_claimed": { "const": false },
    "single_runtime_source_rule_preserved": { "const": true },
    "status_ownership": { "type": "object" },
    "next_action_recommendation": {
      "enum": [
        "ready_for_flocky_review",
        "repair_needed",
        "blocked",
        "approval_required"
      ]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "generated_by": { "const": "codex_auto.autopilot.run_dry_run_flow" },
    "deterministic_dry_run": { "const": true }
  },
  "additionalProperties": true
}
