{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt Pack Render Report",
  "type": "object",
  "required": [
    "type",
    "schema_version",
    "render_only",
    "template_name",
    "target_agent",
    "task_owner",
    "task_type",
    "task_id",
    "rendered_prompt",
    "routing_header",
    "preflight_receiver",
    "preflight_report",
    "safe_to_send_to",
    "unsafe_to_send_to",
    "original_prompt_executed",
    "rendered_prompt_executed",
    "sessions_spawn_allowed",
    "runtime_wiring_allowed",
    "queue_mutation_allowed",
    "active_flocky_tool_integration",
    "single_runtime_source_rule_preserved",
    "warnings",
    "errors",
    "generated_by",
    "deterministic_render"
  ],
  "properties": {
    "type": { "const": "AUTOPILOT_PROMPT_PACK_RENDER_REPORT" },
    "schema_version": { "const": "1.0" },
    "render_only": { "const": true },
    "template_name": { "type": "string", "minLength": 1 },
    "target_agent": { "type": "string", "minLength": 1 },
    "task_owner": { "type": "string", "minLength": 1 },
    "task_type": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "rendered_prompt": { "type": "string", "minLength": 1 },
    "routing_header": { "type": "object" },
    "preflight_receiver": { "type": "string", "minLength": 1 },
    "preflight_report": { "type": "object" },
    "safe_to_send_to": { "type": "array", "items": { "type": "string" } },
    "unsafe_to_send_to": { "type": "array", "items": { "type": "string" } },
    "original_prompt_executed": { "const": false },
    "rendered_prompt_executed": { "const": false },
    "sessions_spawn_allowed": { "const": false },
    "runtime_wiring_allowed": { "const": false },
    "queue_mutation_allowed": { "const": false },
    "active_flocky_tool_integration": { "const": false },
    "single_runtime_source_rule_preserved": { "const": true },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "generated_by": { "const": "codex_auto/autopilot/prompt_packs/render_prompt_pack.py" },
    "deterministic_render": { "const": true }
  }
}
