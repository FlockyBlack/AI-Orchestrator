{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance/schemas/quarantine_record.schema.v1.json",
  "title": "Quarantine Record Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quarantine_id",
    "task_id",
    "source_run_id",
    "detected_at",
    "record_type",
    "severity",
    "reason",
    "violations",
    "safety_flags",
    "blocked_transition",
    "release_condition"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "quarantine_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "source_run_id": { "type": "string", "minLength": 1 },
    "detected_at": { "type": "string", "minLength": 1 },
    "record_type": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["warning", "error", "critical"] },
    "reason": { "type": "string", "minLength": 1 },
    "violations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "safety_flags": { "$ref": "governance_review_bundle.schema.v1.json#/$defs/safetyFlags" },
    "blocked_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_status", "to_status"],
      "properties": {
        "from_status": { "type": "string", "minLength": 1 },
        "to_status": { "type": "string", "minLength": 1 }
      }
    },
    "release_condition": { "type": "string", "minLength": 1 }
  }
}
